{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Dev: Rolldown Watch + Server",
      "cwd": "${workspaceRoot}",
      "console": "integratedTerminal",
      "tasks": [
        {
          "label": "rolldown-watch",
          "type": "shell",
          "command": "node bin/rolldown_build.mjs --watch",
          "isBackground": true,
          "problemMatcher": []
        }
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Dev: Debug Server (Node Inspector)",
      "cwd": "${workspaceRoot}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect=9229",
        "--loader", "ts-node/esm",
        "demo/server/server.ts"
      ],
      "env": {
        "FORCE_COLOR": "0"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "App listening to (http://.*?:[0-9]+)"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Dev: Rolldown Build (once)",
      "cwd": "${workspaceRoot}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "bin/rolldown_build.mjs"
      ],
      "problemMatcher": []
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Dev: Chrome Debug (source maps)",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}/",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Attach to Node (9229)",
      "cwd": "${workspaceRoot}",
      "port": 9229
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Unit Tests",
      "cwd": "${workspaceRoot}",
      "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/mocha",
      "windows": {
        "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/mocha.cmd"
      },
      "runtimeArgs": [
        "--colors",
        "--recursive",
        "${workspaceRoot}/out-esbuild-test/**/*.test.js"
      ],
      "env": {
        "NODE_PATH": "${workspaceRoot}/out-esbuild"
      },
      "sourceMaps": true,
      "outFiles": [ "${workspaceRoot}/out-esbuild/**/*.js" ],
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Integration Tests",
      "cwd": "${workspaceRoot}",
      "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/mocha",
      "windows": {
        "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/mocha.cmd"
      },
      "runtimeArgs": [
        "--colors",
        "--recursive",
        "${workspaceRoot}/out-esbuild-test/**/*api.js"
      ],
      "sourceMaps": true,
      "outFiles": [ "${workspaceRoot}/out-esbuild/**/*.js" ],
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Demo Client (Chrome)",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}/"
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Demo Client (Edge)",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}/"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Demo Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "stopOnEntry": true,
      "runtimeVersion": "22",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "App listening to (http://.*?:[0-9]+)"
      }
    }
  ]
}
